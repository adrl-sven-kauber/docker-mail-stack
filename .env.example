# Copy to .env and fill in. .env is not committed.
MAIL_HOSTNAME=mail.example.com          # A record -> this server; MX of every domain points here
POSTMASTER_ADDRESS=you@example.com
WEBMAIL_TITLE=Mail · example.com
WEBMAIL_PORT=18090                      # Roundcube on 127.0.0.1:<port>, behind host nginx
# 24 random characters: openssl rand -base64 24 | tr -d '/+=' | cut -c1-24
ROUNDCUBEMAIL_DES_KEY=
# Docker network for the stack. Must not clash with other networks on the host.
# If you change it, change config/fail2ban-jail.cf too.
MAIL_SUBNET=172.21.0.0/16
MAIL_GATEWAY=172.21.0.1
